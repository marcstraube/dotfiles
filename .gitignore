# Dotfiles Repository - Ignore everything by default
# Only track what we explicitly add with `dotfiles add -f <file>`

# Ignore everything
*

# Track these directories (when added)
!.config/
!.local/
!.bashrc.d/

# But ignore these patterns even in tracked directories
.cache/
.git/
node_modules/
__pycache__/
*.pyc
*.swp
*.tmp
.DS_Store
