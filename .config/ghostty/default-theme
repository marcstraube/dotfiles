palette = 4=#3B78FF
# magenta
palette = 5=#B4009E
# cyan
palette = 6=#13A6E0
# white
palette = 7=#F0F0F0
# bright-black (gray)
palette = 8=#555555
# bright-red
palette = 9=#FF6B6B
# bright-green
palette = 10=#4EC9B0
# bright-yellow
