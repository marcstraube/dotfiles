# Terminal Core Colors
background = #1A1A1A
foreground = #F0F0F0
cursor-color = #F0F0F0

# Selection Colors
selection-background = #007ACC
selection-foreground = #FFFFFF

# Palette — standard ANSI semantics (slots 0-7 normal, 8-15 brighter).
