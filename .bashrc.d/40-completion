# ============================================================================
# Completion Configuration
# ============================================================================

# Bash completion
if [ -r /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
fi

# Git completion
if [ -r /usr/share/git/completion/git-completion.bash ]; then
    . /usr/share/git/completion/git-completion.bash
    # Enable completion for git aliases
    __git_complete g __git_main
    __git_complete gco _git_checkout
    __git_complete gb _git_branch
    __git_complete gd _git_diff
    __git_complete gl _git_log
    # dotfiles: custom subcommands + git fallback
    _dotfiles_complete() {
        local subcmds="meta health edit-meta sync"
        if [[ "${COMP_CWORD}" -eq 1 ]]; then
            local cur="${COMP_WORDS[COMP_CWORD]}"
            # Custom subcommands first, then git completions
            # shellcheck disable=SC2207  # canonical bash completion idiom
            COMPREPLY=( $(compgen -W "$subcmds" -- "$cur") )
            # Also add git completions
            __git_main
        else
            # After first arg, delegate to git if not a custom subcommand
            case "${COMP_WORDS[1]}" in
                meta|health|edit-meta|sync) return 0 ;;
                *) __git_main ;;
            esac
        fi
    }
    __git_complete dotfiles _dotfiles_complete
fi

# Symfony autocomplete
if command -v symfony &> /dev/null; then
    complete -C "/usr/bin/symfony self:autocomplete" symfony
fi

# fzf key bindings and completion (skip when ble.sh is active — it handles fzf natively)
if ! [[ ${BLE_VERSION-} ]]; then
    if [ -r /usr/share/fzf/key-bindings.bash ]; then
        source /usr/share/fzf/key-bindings.bash
    fi

    if [ -r /usr/share/fzf/completion.bash ]; then
        source /usr/share/fzf/completion.bash
    fi
fi
