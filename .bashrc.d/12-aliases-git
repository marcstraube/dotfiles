# ============================================================================
# Git Aliases
# ============================================================================

alias g='git'
alias gs='git status -sb'
alias gss='git status'

# Add
alias ga='git add'
alias gaa='git add --all'
alias gap='git add --patch'

# Commit
alias gc='git commit -v'
alias gca='git commit -v --amend'
alias gcm='git commit -m'
alias gcam='git commit -am'
alias gcs='git commit -S -m'  # Signed commit

# Branch
alias gb='git branch'
alias gba='git branch -a'
alias gbd='git branch -d'
alias gbD='git branch -D'

# Checkout
alias gco='git checkout'
alias gcb='git checkout -b'
alias gcom='git checkout main 2>/dev/null || git checkout master'

# Diff
alias gd='git diff'
alias gds='git diff --staged'
alias gdc='git diff --cached'

# Log
alias gl='git log --oneline --graph --decorate'
alias gla='git log --oneline --graph --decorate --all'
alias gll='git log --graph --pretty=format:"%C(yellow)%h%C(reset) - %C(cyan)%an%C(reset), %C(green)%ar%C(reset) : %s"'

# Push/Pull
alias gp='git push'
alias gpo='git push origin'
alias gpf='git push --force-with-lease'  # Safer force push
alias gpl='git pull'
alias gplo='git pull origin'
alias gplr='git pull --rebase'

# Fetch
alias gf='git fetch'
alias gfa='git fetch --all'
alias gfo='git fetch origin'

# Stash
alias gst='git stash'
alias gstp='git stash pop'
alias gstl='git stash list'
alias gstd='git stash drop'

# Remote
alias gr='git remote'
alias grv='git remote -v'
alias gra='git remote add'

# Rebase
alias grb='git rebase'
alias grbi='git rebase -i'
alias grba='git rebase --abort'
alias grbc='git rebase --continue'

# Reset
alias grh='git reset HEAD'
alias grhh='git reset --hard HEAD'

# Misc
alias gclean='git clean -fd'
alias gundo='git reset --soft HEAD~1'  # Undo last commit, keep changes
alias gwip='git add -A && git commit -m "WIP"'  # Quick work-in-progress commit

# Dotfiles — bare git repo management
dotfiles() {
    local gitdir="$HOME/Code/dotfiles"
    case "${1:-}" in
        meta)
            shift
            _dotfiles_meta "$gitdir" "$@"
            ;;
        *)
            /usr/bin/git --git-dir="$gitdir" --work-tree="$HOME" "$@"
            ;;
    esac
}

# Commit meta files (README, install.sh, CLAUDE.md) from bare-repo dir
_dotfiles_meta() {
    local gitdir="$1"; shift
    local msg="${1:-docs: update meta files}"
    local tmpindex
    tmpindex=$(mktemp)

    export GIT_INDEX_FILE="$tmpindex" GIT_DIR="$gitdir"
    trap 'rm -f "$tmpindex"; unset GIT_INDEX_FILE GIT_DIR' RETURN

    git read-tree HEAD

    for f in "$gitdir"/*.md "$gitdir"/*.sh "$gitdir"/.claude/*.md; do
        [[ -f "$f" ]] || continue
        local relpath="${f#$gitdir/}"
        local mode=100644
        [[ -x "$f" ]] && mode=100755
        git update-index --add --cacheinfo "$mode,$(git hash-object -w "$f"),$relpath"
    done

    local tree commit
    tree=$(git write-tree)
    commit=$(git commit-tree "$tree" -p HEAD -m "$msg")
    git update-ref refs/heads/master "$commit"

    # Sync meta files into main index with skip-worktree
    # (they live in $gitdir, not $HOME, so must be hidden from worktree status)
    unset GIT_INDEX_FILE
    local meta_paths=()
    for f in "$gitdir"/*.md "$gitdir"/*.sh "$gitdir"/.claude/*.md; do
        [[ -f "$f" ]] || continue
        local relpath="${f#$gitdir/}"
        local mode=100644
        [[ -x "$f" ]] && mode=100755
        git update-index --add --cacheinfo "$mode,$(git rev-parse "HEAD:$relpath"),$relpath"
        meta_paths+=("$relpath")
    done
    if [[ ${#meta_paths[@]} -gt 0 ]]; then
        # Paths must resolve from worktree root, not CWD
        (cd "$HOME" && GIT_WORK_TREE="$HOME" git update-index --skip-worktree "${meta_paths[@]}")
    fi

    echo "Committed: $(git --git-dir="$gitdir" log --oneline -1)"
}

alias dfs='dotfiles status -sb'
alias dfa='dotfiles add -f'
alias dfc='dotfiles commit -S -m'
alias dfp='dotfiles push'
alias dfmeta='dotfiles meta'
