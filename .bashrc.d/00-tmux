# ============================================================================
# tmux - Auto-attach on SSH login + `ta` session helper
# Loaded first: the outer SSH shell execs into tmux before loading the rest,
# the shell inside tmux then sources the full config.
# ============================================================================

command -v tmux &> /dev/null || return 0

# ta [name] - Attach to a session (created if missing)
#   no name:     most recently used session, or new "main"
#   inside tmux: switch client instead of nesting
ta() {
    if [[ -n $TMUX ]]; then
        if [[ -z $1 ]]; then
            tmux choose-tree -Zs
        else
            tmux has-session -t "=$1" 2> /dev/null || tmux new-session -d -s "$1"
            tmux switch-client -t "=$1"
        fi
    elif [[ -z $1 ]]; then
        if tmux has-session 2> /dev/null; then
            tmux attach-session
        else
            tmux new-session -s main
        fi
    else
        tmux new-session -A -s "$1"
    fi
}

_ta_complete() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    mapfile -t COMPREPLY < <(compgen -W "$(tmux list-sessions -F '#S' 2> /dev/null)" -- "$cur")
}
complete -F _ta_complete ta

# Auto-attach on SSH login
# Skip: already in tmux, no TTY, IDE terminals, or NO_TMUX set.
# Escape hatch: ssh -t <host> 'NO_TMUX=1 exec bash -i'
if [[ -n $SSH_CONNECTION && -z $TMUX && -z $NO_TMUX && -t 0 && -t 1 ]] \
    && [[ $TERMINAL_EMULATOR != JetBrains-JediTerm && $TERM_PROGRAM != vscode ]]; then
    if tmux has-session 2> /dev/null; then
        exec tmux attach-session
    else
        exec tmux new-session -s main
    fi
fi
