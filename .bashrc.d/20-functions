# Fast and easy file backup
bu() {
    if [ -z "$1" ]; then
        echo "Usage: bu <file>"
        return 1
    fi
    cp -v "${1}" "${1}-$(date +%Y%m%d%H%M).backup"
}

# Create new archive (FIXED)
compress() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: compress <archive.ext> <files...>"
        return 1
    fi

    local archive="$1"
    shift

    case "${archive}" in
        *.tar.bz2)  tar cjf "${archive}" "$@" ;;
        *.tar.gz)   tar czf "${archive}" "$@" ;;
        *.tgz)      tar czf "${archive}" "$@" ;;
        *.tar.xz)   tar cJf "${archive}" "$@" ;;
        *.zip)      zip -r "${archive}" "$@" ;;
        *.7z)       7z a "${archive}" "$@" ;;
        *.rar)      rar a "${archive}" "$@" ;;
        *)          echo "Error: Unsupported archive format"
                    echo "Supported: .tar.gz, .tar.bz2, .tar.xz, .tgz, .zip, .7z, .rar"
                    return 1 ;;
    esac
}

# Extract the most common archive file types (FIXED)
extract() {
    if [ -z "$1" ]; then
        echo "Usage: extract <archive>"
        return 1
    fi

    if [ ! -f "$1" ]; then
        echo "Error: '$1' is not a valid file"
        return 1
    fi

    case "$1" in
        *.tar.bz2|*.tbz2)   tar xjf "$1" ;;
        *.tar.gz|*.tgz)     tar xzf "$1" ;;
        *.tar.xz|*.txz)     tar xJf "$1" ;;
        *.tar)              tar xf "$1" ;;
        *.bz2)              bunzip2 "$1" ;;
        *.gz)               gunzip "$1" ;;
        *.zip)              unzip "$1" ;;
        *.7z)               7z x "$1" ;;
        *.rar)              unrar x "$1" ;;
        *.Z)                uncompress "$1" ;;
        *.xz)               unxz "$1" ;;
        *.zst)              unzstd "$1" ;;
        *)                  echo "Error: '$1' cannot be extracted"
                            echo "Unsupported format"
                            return 1 ;;
    esac
}

# Create directory and change into it
mkcd() {
    if [ -z "$1" ]; then
        echo "Usage: mkcd <directory>"
        return 1
    fi
    mkdir -p -v "$1" && cd "$1" || return 1
}

# Make a new alias and persist it
mkalias() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: mkalias <name> \"<command>\""
        return 1
    fi
    echo "alias ${1}=\"${2}\"" >> "${HOME}/.bashrc.d/99-custom-aliases"
    alias "${1}=${2}"
    echo "Alias created: ${1}='${2}'"
}

# Remove an alias
rmalias() {
    if [ -z "$1" ]; then
        echo "Usage: rmalias <alias-name>"
        return 1
    fi
    unalias "$1" 2>/dev/null && \
    sed -i "/alias ${1}=/d" "${HOME}/.bashrc.d/99-custom-aliases" && \
    echo "Alias removed: $1"
}

# Clone AUR package
aurclone() {
    if [ -z "$1" ]; then
        echo "Usage: aurclone <package-name>"
        return 1
    fi
    git clone "https://aur.archlinux.org/${1}.git"
}

# Find and cd to directory (if fzf is available)
if command -v fzf &> /dev/null; then
    fcd() {
        local dir
        dir=$(fd --type d --hidden --follow --exclude .git | fzf --preview 'eza --tree --level=2 --icons {}') && cd "$dir" || return
    }
fi

# Search and edit file with fzf + nvim
if command -v fzf &> /dev/null; then
    fe() {
        local file
        file=$(fzf --preview 'bat --color=always --style=numbers --line-range=:500 {}') && nvim "$file"
    }
fi

# Git checkout branch with fzf
if command -v fzf &> /dev/null; then
    gcof() {
        local branch
        branch=$(git branch --all | grep -v HEAD | sed 's/remotes\/origin\///g' | sort -u | fzf --preview 'git log --oneline --graph --date=short --pretty="format:%C(auto)%cd %h%d %s" {}') && git checkout "$(echo "$branch" | sed 's/^[ *]*//')"
    }
fi

# Quick note taking
note() {
    local note_dir="$HOME/notes"
    mkdir -p "$note_dir"
    local note_file="$note_dir/$(date +%Y-%m-%d).md"

    if [ -z "$1" ]; then
        nvim "$note_file"
    else
        echo "$(date +"%H:%M:%S") - $*" >> "$note_file"
        echo "Note added to $note_file"
    fi
}

# Quick file search
ff() {
    find . -type f -iname "*$1*" 2>/dev/null
}

# Quick directory search
fd_dir() {
    find . -type d -iname "*$1*" 2>/dev/null
}

# Show disk usage of current directory
usage() {
    du -h --max-depth=1 . | sort -h
}

# Create and navigate to a temporary directory
tmpd() {
    local tmpdir=$(mktemp -d)
    echo "Created temporary directory: $tmpdir"
    cd "$tmpdir" || return 1
}
