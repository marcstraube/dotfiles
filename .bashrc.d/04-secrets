# ============================================================================
# Secrets Management (sops + age)
# ============================================================================

# Set age key file if it exists
if [[ -f "$HOME/.config/age/key.txt" ]]; then
    export SOPS_AGE_KEY_FILE="$HOME/.config/age/key.txt"
fi

# Only define commands if both tools are installed
if command -v sops &>/dev/null && command -v age &>/dev/null; then

    # Edit an encrypted secrets file
    secrets-edit() {
        local file="${1:?Usage: secrets-edit <file>}"
        if [[ ! -f "$file" ]]; then
            echo "File not found: $file"
            return 1
        fi
        sops edit "$file"
    }

    # Show decrypted contents of a secrets file
    secrets-show() {
        local file="${1:?Usage: secrets-show <file>}"
        if [[ ! -f "$file" ]]; then
            echo "File not found: $file"
            return 1
        fi
        sops decrypt "$file"
    }

fi
